#!/usr/bin/env bash

set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
applications_dir="$data_home/applications"
launcher="$applications_dir/billyjacoby.bubbles.desktop"
bin_home=${XDG_BIN_HOME:-"$HOME/.local/bin"}

mkdir -p "$applications_dir" "$bin_home"
ln -sfn "$plugin_dir/bin/open" "$bin_home/bubbles-tui"
ln -sfn "$plugin_dir/billyjacoby.bubbles.desktop" "$launcher"
