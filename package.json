{
  "name": "bubbles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @bubbles/shared build && pnpm --filter @bubbles/web dev",
    "dev:tui": "pnpm --filter @bubbles/shared build && pnpm --filter @bubbles/tui dev",
    "build": "pnpm --filter @bubbles/shared build && pnpm --filter @bubbles/web build && pnpm --filter @bubbles/tui build",
    "start": "pnpm --filter @bubbles/web start",
    "tui": "pnpm --filter @bubbles/shared build && pnpm --filter @bubbles/tui start",
    "notify": "pnpm --filter @bubbles/shared build && pnpm --filter @bubbles/tui notify",
    "lint": "pnpm --filter @bubbles/shared lint && pnpm --filter @bubbles/web lint && pnpm --filter @bubbles/tui lint",
    "verify": "pnpm --filter @bubbles/shared build && pnpm --filter @bubbles/web verify",
    "diagnose": "pnpm --filter @bubbles/web diagnose",
    "diagnose:chatlist": "pnpm --filter @bubbles/web diagnose:chatlist"
  }
}
